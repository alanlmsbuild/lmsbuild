# Copy this file to .env and fill in real values.
# .env is gitignored so real credentials never get committed.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Path to the private key file used for key-pair authentication.
# The file itself must live outside the repo (or be gitignored) and is
# only ever read by the server process, never sent to the browser.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only needed if the private key file is passphrase-protected.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Port the API server listens on.
PORT=3001

# Skills England occupational maps API key, used by npm run import:skills and
# sent as the X-API-KEY header. Request one at
# https://occupational-maps.skillsengland.education.gov.uk/public-api/
SKILLS_ENGLAND_API_KEY=

# DEVELOPMENT ONLY, until there is real sign-in. true turns on test
# sign-in: the /sign-in page lists the test users (ISTESTDATA = TRUE) and
# picking one signs this browser in as them (a cookie). Missing, empty or
# anything else: the cookie is ignored, /sign-in lists nobody, and everyone
# is signed out. The server won't start with this set when NODE_ENV is
# production.
TEST_SIGN_IN=

# Optional. How long opening a Snowflake session may take before the request
# is answered "Couldn't reach the database just now. Please try again."
# (milliseconds, default 10000).
DB_CONNECT_TIMEOUT_MS=

# Optional. Requests slower than this are logged with how long each stage
# took: opening the session, signing in, and the route's own work
# (milliseconds, default 2000). Failed, timed-out and abandoned requests are
# always logged. DB_TIMING_LOG=all logs every request.
SLOW_REQUEST_MS=
DB_TIMING_LOG=

# Optional. Open Snowflake sessions are reused between requests
# (server/sessionPool.js); off opens and closes one for every request
# instead.
# Every request still looks up the user and their roles and sets every
# session variable afresh; they're unset when the session comes back.
# DB_POOL_MAX is the most sessions open at once (default 8).
DB_POOL=
DB_POOL_MAX=
