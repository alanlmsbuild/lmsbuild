# Copy this file to .env and fill in real values.
# .env is gitignored so real credentials never get committed.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Path to the private key file used for key-pair authentication.
# The file itself must live outside the repo (or be gitignored) and is
# only ever read by the server process, never sent to the browser.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only needed if the private key file is passphrase-protected.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Port the API server listens on.
PORT=3001

# Skills England occupational maps API key, used by npm run import:ksbs and
# sent as the X-API-KEY header. Request one at
# https://occupational-maps.skillsengland.education.gov.uk/public-api/
SKILLS_ENGLAND_API_KEY=

# DEVELOPMENT ONLY, until there is real sign-in: the ACCESS.APP_USER the
# server acts as. Every request sees only this user's organisation.
# e.g. USR-T0008 (Max, manager, ORG-T001) or USR-T0011 (Nia, manager, ORG-T002).
DEV_USER_ID=
