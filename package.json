{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "test:connection": "node server/test-connection.js",
    "import:lars": "node scripts/import-lars.js",
    "remap:standards": "node scripts/remap-standards.js",
    "build": "vite build",
    "lint": "oxlint",
    "check:scoping": "node scripts/check-org-scoping.js",
    "check:sign-in": "node scripts/check-sign-in.js",
    "check:test-flags": "node scripts/check-test-flags.js",
    "check:grants": "node scripts/check-grants.js",
    "refresh:companies": "node scripts/refresh-companies.js",
    "import:vacancies": "node scripts/import-vacancies.js",
    "preview": "vite preview",
    "import:ref": "node scripts/import-ref.js",
    "import:skills": "node scripts/import-skills.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "snowflake-sdk": "^3.3.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
